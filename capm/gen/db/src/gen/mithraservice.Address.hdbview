VIEW mithraservice_Address AS SELECT
  Address_0.NODE_KEY,
  Address_0.CITY,
  Address_0.POSTAL_CODE,
  Address_0.STREET,
  Address_0.BUILDING,
  Address_0.COUNTRY,
  Address_0.ADDRESS_TYPE,
  Address_0.VAL_START_DATE,
  Address_0.VAL_END_DATE,
  Address_0.LATITUDE,
  Address_0.LONGITUDE
FROM mithra_db_Address AS Address_0