COLUMN TABLE mithra_db_businesspartner (
  NODE_KEY NVARCHAR(33) NOT NULL,
  BP_ROLE NVARCHAR(2),
  EMAIL_ADDRESS NVARCHAR(105),
  PHONE_NUMBER NVARCHAR(32),
  FAX_NUMBER NVARCHAR(32),
  WEB_ADDRESS NVARCHAR(44),
  ADDRESS_GUID_NODE_KEY NVARCHAR(33),
  BP_ID NVARCHAR(32),
  COMPANY_NAME NVARCHAR(25),
  PRIMARY KEY(NODE_KEY)
)