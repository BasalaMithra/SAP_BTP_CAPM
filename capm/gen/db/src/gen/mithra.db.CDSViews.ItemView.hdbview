VIEW mithra_db_CDSViews_ItemView AS SELECT
  PARENT_KEY_1.PARTNER_GUID_NODE_KEY AS Partner,
  poitems_0.PRODUCT_GUID_NODE_KEY AS ProductId,
  poitems_0.CURRENCY_CODE AS CurrencyCode,
  poitems_0.GROSS_AMOUNT AS GrossAmount,
  poitems_0.NET_AMOUNT AS NetAmount,
  poitems_0.TAX_AMOUNT AS TaxAmount,
  PARENT_KEY_1.OVERALL_STATUS AS POStatus
FROM (mithra_db_poitems AS poitems_0 LEFT JOIN mithra_db_purchaseorder AS PARENT_KEY_1 ON poitems_0.PARENT_KEY_NODE_KEY = PARENT_KEY_1.NODE_KEY)