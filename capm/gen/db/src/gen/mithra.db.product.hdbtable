COLUMN TABLE mithra_db_product (
  NODE_KEY NVARCHAR(33) NOT NULL,
  PRODUCT_ID NVARCHAR(8),
  TYPE_CODE NVARCHAR(2),
  CATEGORY NVARCHAR(32),
  DESCRIPTION NVARCHAR(255),
  NAME NVARCHAR(65),
  SUPPLIER_GUID_NODE_KEY NVARCHAR(33),
  TAX_TARIF_CODE INTEGER,
  MEASURE_UNIT NVARCHAR(2),
  WEIGHT_MEASURE DECIMAL,
  WEIGHT_UNIT NVARCHAR(2),
  CURRENCY_CODE NVARCHAR(4),
  PRICE DECIMAL,
  WIDTH DECIMAL,
  "DEPTH" DECIMAL,
  HEIGHT DECIMAL,
  DIM_UNIT NVARCHAR(2),
  PRIMARY KEY(NODE_KEY)
)