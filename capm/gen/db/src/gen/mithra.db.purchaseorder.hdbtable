COLUMN TABLE mithra_db_purchaseorder (
  NODE_KEY NVARCHAR(33) NOT NULL,
  PO_ID NVARCHAR(9),
  PARTNER_GUID_NODE_KEY NVARCHAR(33),
  CURRENCY_CODE NVARCHAR(4),
  GROSS_AMOUNT DECIMAL,
  NET_AMOUNT DECIMAL,
  TAX_AMOUNT DECIMAL,
  LIFECYCLE_STATUS NVARCHAR(1),
  OVERALL_STATUS NVARCHAR(1),
  NOTE NVARCHAR(256),
  PRIMARY KEY(NODE_KEY)
)