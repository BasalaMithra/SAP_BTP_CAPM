COLUMN TABLE mithra_db_Address (
  NODE_KEY NVARCHAR(33) NOT NULL,
  CITY NVARCHAR(44),
  POSTAL_CODE NVARCHAR(8),
  STREET NVARCHAR(44),
  BUILDING NVARCHAR(128),
  COUNTRY NVARCHAR(9),
  ADDRESS_TYPE NVARCHAR(44),
  VAL_START_DATE DATE,
  VAL_END_DATE DATE,
  LATITUDE DECIMAL,
  LONGITUDE DECIMAL,
  PRIMARY KEY(NODE_KEY)
)